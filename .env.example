PORT=3000
API_KEY=change-this-to-a-long-random-string

# Optional: give specific people their own admin key instead of everyone
# sharing API_KEY above. Comma-separated Name:key pairs.
# ADMIN_KEYS=Nahid:another-long-random-string,Asif:yet-another-long-random-string

# ---------- Primary KV Database: Supabase PostgreSQL ----------
# Stores accounts-registry, group-mapping, kam-account-mapping, and OpenWA Gateway URL
# so Vercel, Render Docker, and your KVM VPS all share the exact same live database!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional legacy fallback (used only if SUPABASE_URL is not set):
# TURSO_DB_URL=https://your-db-name-your-org.turso.io/v2/pipeline
# TURSO_DB_TOKEN=your-turso-auth-token

# ---------- OpenWA Gateway connection ----------
# On VPS Docker: if you set PUBLIC_GATEWAY_URL=http://YOUR_VPS_IP:3000 along with SUPABASE_URL,
# the container automatically registers itself so your Vercel URL connects with zero manual steps!
# PUBLIC_GATEWAY_URL=http://YOUR_VPS_IP:3000

# Optional manual override (only if not using /admin Section 0 or bundled Docker):
# OPENWA_BASE_URL=http://127.0.0.1:2785
# OPENWA_API_KEY=owa_k1_your_64_hex_chars_key
