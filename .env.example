PORT=3000
API_KEY=change-this-to-a-long-random-string

# Optional: give specific people their own admin key instead of everyone
# sharing API_KEY above. Comma-separated Name:key pairs.
# ADMIN_KEYS=Nahid:another-long-random-string,Asif:yet-another-long-random-string

# Turso database (stores dashboard group mappings, KAM mappings, and account list
# so moving from Render to VPS keeps all mappings automatically)
TURSO_DB_URL=https://your-db-name-your-org.turso.io/v2/pipeline
TURSO_DB_TOKEN=your-turso-auth-token

# ---------- OpenWA Gateway connection ----------
# Inside the bundled Docker / Render container, these are wired automatically
# (OpenWA runs on http://127.0.0.1:2785 and its key is read from /app/data/.api-key).
# Only set these if CarryBee Bridge runs separately (e.g. on Vercel or local `npm start`)
# pointing at an external OpenWA Gateway URL:
# OPENWA_BASE_URL=http://127.0.0.1:2785
# OPENWA_API_KEY=your-openwa-admin-key-at-least-32-chars
